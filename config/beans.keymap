#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt { flavor = "balanced"; };

&lt { flavor = "hold-preferred"; };

/ {
    macros {
        quick_thumbs_up: quick_thumbs_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp LS(Y) &kp RPAR>;
            label = "QUICK_THUMBS_UP";
        };

        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(G) &kp LS(R) &kp LS(E) &kp LS(E) &kp LS(N) &kp D &kp O &kp G &kp N5 &kp PRCNT>;
            label = "PW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC       &kp Q  &kp W         &kp E             &kp R  &kp T        &kp Y          &kp U  &kp I              &kp O    &kp P     &kp EQUAL
&kp TAB       &kp A  &kp S         &mt LEFT_SHIFT D  &kp F  &kp G        &kp H          &kp J  &mt RIGHT_SHIFT K  &kp L    &kp SEMI  &kp SQT
&kp LEFT_GUI  &kp Z  &kp X         &kp C             &kp V  &kp B        &kp N          &kp M  &kp COMMA          &kp DOT  &kp FSLH  &kp MINUS
                     &kp LEFT_ALT  &lt 2 DELETE      &mo 1  &kp SPACE    &kp BACKSPACE  &mo 1  &lt 2 DELETE       &kp RET
            >;
        };

        numbers_symbols {
            bindings = <
&trans  &none         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none            &kp DOLLAR  &kp PERCENT           &kp HASH  &kp ASTRK              &kp TILDE      &none
&trans  &kp NUMBER_0  &kp N4        &kp N5        &kp NUMBER_6  &kp BACKSPACE    &kp AT      &kp LEFT_PARENTHESIS  &kp EXCL  &kp RIGHT_PARENTHESIS  &kp N0         &kp PIPE
&trans  &none         &kp N7        &kp N8        &kp N9        &none            &kp CARET   &kp LEFT_BRACKET      &kp AMPS  &kp RIGHT_BRACKET      &kp BACKSLASH  &quick_thumbs_up
                      &trans        &none         &none         &trans           &trans      &none                 &none     &trans
            >;
        };

        figma {
            bindings = <
&kp LG(LS(NUMBER_4))  &none          &kp BACKSLASH      &kp UP_ARROW  &kp ENTER   &kp LG(R)        &out OUT_BLE  &none     &kp UP_ARROW  &none      &none  &bt BT_CLR
&kp LS(LG(C))         &kp LS(LG(H))  &kp LEFT           &kp DOWN      &kp RIGHT   &kp LA(LG(G))    &out OUT_USB  &kp LEFT  &kp DOWN      &kp RIGHT  &none  &bt BT_SEL 0
&kp LCTRL             &kp LS(LG(L))  &kp LG(BACKSLASH)  &kp LA(N8)    &kp LA(N9)  &kp LA(LG(B))    &none         &none     &none         &none      &none  &bt BT_SEL 1
                                     &none              &none         &none       &none            &pw           &none     &none         &none
            >;
        };
    };
};
