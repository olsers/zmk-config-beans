#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt { flavor = "balanced"; };

&lt { flavor = "hold-preferred"; };

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &kp Q  &kp W         &kp E             &kp R  &kp T        &kp Y          &kp U  &kp I              &kp O    &kp P     &kp EQUAL
&kp TAB    &kp A  &kp S         &mt LEFT_SHIFT D  &kp F  &kp G        &kp H          &kp J  &mt RIGHT_SHIFT K  &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X         &kp C             &kp V  &kp B        &kp N          &kp M  &kp COMMA          &kp DOT  &kp FSLH  &kp MINUS
                  &kp LEFT_ALT  &lt 2 DELETE      &mo 1  &kp SPACE    &kp BACKSPACE  &mo 1  &lt 2 DELETE       &kp RET
            >;
        };

        numbers_symbols {
            bindings = <
&none  &none         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none     &kp DOLLAR  &kp PERCENT           &kp HASH  &kp ASTRK              &kp TILDE      &sl 3
&none  &kp NUMBER_0  &kp N4        &kp N5        &kp NUMBER_6  &none     &kp AT      &kp LEFT_PARENTHESIS  &kp EXCL  &kp RIGHT_PARENTHESIS  &kp N0         &kp PIPE
&none  &none         &kp N7        &kp N8        &kp N9        &none     &kp CARET   &kp LEFT_BRACKET      &kp AMPS  &kp RIGHT_BRACKET      &kp BACKSLASH  &none
                     &none         &none         &none         &trans    &trans      &none                 &none     &none
            >;
        };

        figma {
            bindings = <
&kp LG(LS(S))     &kp BACKSLASH  &kp ENTER          &kp UP_ARROW  &kp LC(LS(R))  &kp LC(LA(LS(T)))    &out OUT_BLE    &none     &kp UP_ARROW    &none               &none         &bt BT_CLR
&kp LG(V)         &kp LC(LS(H))  &kp LEFT           &kp DOWN      &kp RIGHT      &kp LA(LC(G))        &out OUT_USB    &kp LEFT  &kp DOWN        &kp RIGHT           &kp LEFT_GUI  &bt BT_SEL 0
&kp LEFT_CONTROL  &kp LC(LS(L))  &kp LC(BACKSLASH)  &kp LA(N8)    &kp LA(N9)     &kp LC(LA(B))        &kp LG(PERIOD)  &none     &kp LEFT_SHIFT  &none               &none         &bt BT_SEL 1
                                 &none              &none         &none          &kp LG(TAB)          &none           &none     &none           &kp LC(LA(DELETE))
            >;
        };

        fn_layer {
            bindings = <
&none  &none  &none  &none  &none  &none    &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&none  &none  &none  &none  &none  &none    &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&none  &none  &none  &none  &none  &none    &none   &none   &none   &none    &none    &none
              &none  &none  &none  &none    &none   &none   &none   &none
            >;
        };
    };
};
